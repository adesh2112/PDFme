/* ============================================================
   Pdfme — styles.css
   High-performance futuristic dark design
   ============================================================ */

/* ── Fonts are loaded via /fonts/fonts.css ── */

/* ── Design Tokens ── */
:root {
  /* Colours */
  --bg:            #070B14;
  --bg-2:          #0D1322;
  --surface:       rgba(13, 19, 34, 0.88);
  --surface-hover: rgba(20, 30, 55, 0.95);
  --border:        rgba(255, 255, 255, 0.08);
  --border-glow:   rgba(34, 211, 238, 0.30);
  --text:          #E8EDF5;
  --text-muted:    #7A8AA5;
  --accent-cyan:   #22D3EE;
  --accent-violet: #8B5CF6;
  --accent-magenta:#D946EF;
  --accent-grad:   linear-gradient(135deg, #22D3EE 0%, #8B5CF6 100%);
  --danger:        #F87171;
  --success:       #34D399;
  --warning:       #FBBF24;
  --highlight-col: rgba(251, 191, 36, 0.40);

  /* Spacing & radius */
  --r-sm:  8px;
  --r-md:  14px;
  --r-lg:  20px;
  --r-xl:  28px;
  --gap:   20px;

  /* Transitions */
  --ease:  cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-o:cubic-bezier(0.25, 0.46, 0.45, 0.94);

  /* Font */
  --font: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
}

/* Light theme */
@media (prefers-color-scheme: light) {
  :root {
    --bg:            #F0F4FF;
    --bg-2:          #E4ECFF;
    --surface:       rgba(255, 255, 255, 0.92);
    --surface-hover: rgba(240, 246, 255, 0.98);
    --border:        rgba(100, 130, 200, 0.18);
    --border-glow:   rgba(34, 211, 238, 0.40);
    --text:          #0D1322;
    --text-muted:    #4A5A7A;
  }
}

/* ── Reset ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: var(--font);
  background:
    radial-gradient(circle at 15% 15%, rgba(34, 211, 238, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 85% 85%, rgba(139, 92, 246, 0.08) 0%, transparent 45%),
    var(--bg);
  background-attachment: fixed;
  color: var(--text);
  min-height: 100dvh;
  overflow-x: hidden;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
}

/* Pause animations when document is hidden */
body.anim-paused * {
  animation-play-state: paused !important;
}

/* ── App shell ── */
#app {
  position: relative;
  z-index: 1;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

/* ── Header (Element 1 with backdrop-filter) ── */
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  gap: 12px;
  background: rgba(7, 11, 20, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: env(safe-area-inset-top, 0);
  z-index: 100;
}

.logo {
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  background: var(--accent-grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  cursor: pointer;
  text-decoration: none;
}

.back-btn {
  display: none;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  color: var(--text-muted);
  font: 500 0.9rem var(--font);
  cursor: pointer;
  padding: 8px 12px;
  border-radius: var(--r-md);
  transition: color 0.15s, background 0.15s;
  min-height: 44px;
}
.back-btn:hover { color: var(--text); background: var(--surface); }
.back-btn svg { flex-shrink: 0; }

header[data-show-back="true"] .back-btn { display: flex; }

/* ── Screens ── */
.screen {
  display: none;
  flex: 1;
  padding: 32px 24px;
  max-width: 900px;
  width: 100%;
  margin: 0 auto;
}
.screen.active {
  display: block;
  animation: screenIn 0.25s var(--ease-o) both;
}

@keyframes screenIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Home ── */
.hero {
  text-align: center;
  padding: 48px 0 40px;
}

.hero-headline {
  font-size: clamp(2rem, 6vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  background: var(--accent-grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16px;
}

.hero-headline .word {
  display: inline-block;
}

.hero-sub {
  color: var(--text-muted);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 480px;
  margin: 0 auto;
}

/* Tiles */
.tiles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: var(--gap);
  margin-top: 32px;
}

.tile-edit { grid-column: 1 / -1; }

.tile {
  position: relative;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: 32px 28px;
  cursor: pointer;
  transition: transform 0.2s var(--ease), border-color 0.2s;
  min-height: 44px;
  outline: none;
}

.tile::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

.tile:hover, .tile:focus-visible {
  border-color: var(--border-glow);
  transform: translateY(-4px);
}

.tile-edit {
  padding: 36px 32px;
  border-color: rgba(34, 211, 238, 0.2);
}

.tile-icon {
  width: 56px;
  height: 56px;
  margin-bottom: 20px;
  color: var(--accent-cyan);
}
.tile-edit .tile-icon { width: 64px; height: 64px; }

.tile-title {
  font-size: 1.3rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}
.tile-edit .tile-title { font-size: 1.5rem; }

.tile-desc {
  color: var(--text-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

.tile-arrow {
  position: absolute;
  bottom: 24px;
  right: 24px;
  color: var(--accent-cyan);
  opacity: 0.6;
  transition: transform 0.15s, opacity 0.15s;
}
.tile:hover .tile-arrow { transform: translate(3px, -3px); opacity: 1; }

/* ── Glass panel (Opaque background, NO backdrop-filter for speed) ── */
.glass-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 24px;
}

/* ── Buttons ── */
.btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font: 600 0.875rem var(--font);
  letter-spacing: 0.01em;
  border: none;
  border-radius: var(--r-md);
  cursor: pointer;
  min-height: 44px;
  padding: 10px 20px;
  transition: transform 0.15s var(--ease), opacity 0.15s;
  overflow: hidden;
  outline: none;
  text-decoration: none;
}

.btn-sm {
  min-height: 32px;
  padding: 6px 14px;
  font-size: 0.8rem;
  border-radius: var(--r-sm);
}

.btn:active { transform: scale(0.97); }

.btn-primary {
  background: var(--accent-grad);
  color: #fff;
}
.btn-primary:hover {
  filter: brightness(1.1);
}

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-secondary:hover { border-color: var(--border-glow); }

.btn-ghost {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
}
.btn-ghost:hover { color: var(--text); border-color: var(--border-glow); }

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  pointer-events: none;
}

:focus-visible {
  outline: 2px solid var(--accent-cyan);
  outline-offset: 3px;
}

/* ── File drop zone ── */
.drop-zone {
  border: 2px dashed var(--border);
  border-radius: var(--r-lg);
  padding: 40px 20px;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.15s, background-color 0.15s;
  position: relative;
}
.drop-zone:hover, .drop-zone.drag-over {
  border-color: var(--accent-cyan);
  background: rgba(34, 211, 238, 0.04);
}
.drop-zone input[type="file"] {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}
.drop-zone-icon { color: var(--accent-cyan); margin-bottom: 12px; }
.drop-zone-text { color: var(--text-muted); font-size: 0.9rem; }
.drop-zone-text strong { color: var(--text); }

/* ── File list ── */
.file-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.scrollable-file-list {
  max-height: 420px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.2) transparent;
  padding-right: 4px;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 8px 12px;
  cursor: grab;
  transition: transform 0.15s, border-color 0.15s;
  min-height: 48px;
}
.file-item:active { cursor: grabbing; }
.file-item.dragging {
  border-color: var(--accent-cyan);
  opacity: 0.7;
}
.file-item.drag-over-indicator {
  border-top: 2px solid var(--accent-cyan);
}

.file-drag-handle {
  cursor: grab;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  padding: 4px;
  flex-shrink: 0;
}
.file-drag-handle:hover { color: var(--text); }

.file-item-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 211, 238, 0.10);
  border-radius: var(--r-sm);
  flex-shrink: 0;
  color: var(--accent-cyan);
}
.file-item-thumb {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: var(--r-sm);
  flex-shrink: 0;
  background: var(--bg);
}
.file-item-name {
  flex: 1;
  font-size: 0.875rem;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.file-item-pages {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent-cyan);
  background: rgba(34, 211, 238, 0.08);
  border-radius: 4px;
  padding: 2px 6px;
  white-space: nowrap;
  flex-shrink: 0;
}
.file-item-size {
  font-size: 0.75rem;
  color: var(--text-muted);
  flex-shrink: 0;
}

.file-item-controls {
  display: flex;
  gap: 2px;
  flex-shrink: 0;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  min-height: 34px;
  min-width: 34px;
  border-radius: var(--r-sm);
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  transition: background-color 0.12s, color 0.12s;
}
.icon-btn:hover { background: var(--surface-hover); color: var(--text); }
.icon-btn:active { transform: scale(0.92); }
.icon-btn.danger:hover { background: rgba(248,113,113,0.15); color: var(--danger); }
.icon-btn:disabled { opacity: 0.25; cursor: default; }

/* ── Action row ── */
.action-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 20px;
  flex-wrap: wrap;
}

/* ── Section label & Summary ── */
.section-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  gap: 12px;
}

.section-label {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.merge-summary-pill {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent-cyan);
  background: rgba(34, 211, 238, 0.10);
  border: 1px solid rgba(34, 211, 238, 0.25);
  border-radius: 100px;
  padding: 3px 12px;
  white-space: nowrap;
}

/* ── Linear Progress bar ── */
.progress-wrap {
  display: none;
  flex-direction: column;
  width: 100%;
  margin-top: 16px;
  gap: 8px;
}
.progress-wrap.visible { display: flex; }

.progress-bar-track {
  width: 100%;
  height: 6px;
  background: rgba(255,255,255,0.1);
  border-radius: 100px;
  overflow: hidden;
  position: relative;
}
.progress-bar-fill {
  height: 100%;
  background: var(--accent-grad);
  width: 0%;
  transition: width 0.15s ease-out;
  border-radius: 100px;
}

.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.progress-label {
  font-size: 0.875rem;
  color: var(--text-muted);
}

/* ── Toast ── */
.toast-container {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
  display: flex;
  flex-direction: column-reverse;
  gap: 8px;
  align-items: center;
  pointer-events: none;
  width: min(90vw, 400px);
}

.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 12px 16px;
  font-size: 0.875rem;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  pointer-events: auto;
  transform: translateY(20px);
  opacity: 0;
  transition: transform 0.25s var(--ease-o), opacity 0.25s;
  width: 100%;
}
.toast.in { transform: translateY(0); opacity: 1; }
.toast.out { transform: translateY(20px); opacity: 0; }

.toast-icon { flex-shrink: 0; }
.toast.error   { border-color: rgba(248,113,113,0.4); }
.toast.success { border-color: rgba(52,211,153,0.4); }
.toast.error   .toast-icon { color: var(--danger); }
.toast.success .toast-icon { color: var(--success); }
.toast-msg { flex: 1; line-height: 1.4; word-break: break-word; }

/* ── Options row ── */
.options-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.radio-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 100px;
  border: 1px solid var(--border);
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: color 0.15s, border-color 0.15s;
  min-height: 36px;
  background: transparent;
}
.radio-pill input { display: none; }
.radio-pill:has(input:checked),
.radio-pill.checked {
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
  background: rgba(34,211,238,0.08);
}

/* ── Edit screen layout ── */
#screen-edit {
  padding: 0;
  max-width: 100%;
}

.edit-layout {
  display: flex;
  flex-direction: column;
  min-height: calc(100dvh - 60px);
}

.edit-canvas-area {
  flex: 1;
  overflow-y: auto;
  padding: 24px 16px 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

/* ── Virtual Page Container ── */
.page-wrap {
  position: relative;
  display: inline-block;
  box-shadow: 0 4px 24px rgba(0,0,0,0.45);
  border-radius: var(--r-sm);
  overflow: visible;
  content-visibility: auto;
  contain-intrinsic-size: 595px 842px;
  background: var(--bg-2);
}

.page-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border-radius: var(--r-sm);
  color: var(--text-muted);
  font-size: 0.9rem;
}

.page-canvas {
  display: block;
  border-radius: var(--r-sm);
}

.overlay-canvas {
  position: absolute;
  top: 0; left: 0;
  border-radius: var(--r-sm);
  touch-action: auto;
}

/* Page controls */
.page-controls {
  position: absolute;
  top: 8px;
  right: -48px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  opacity: 0;
  transition: opacity 0.15s;
}
.page-wrap:hover .page-controls { opacity: 1; }

@media (max-width: 700px) {
  .page-controls {
    right: auto;
    left: 0;
    top: auto;
    bottom: -44px;
    flex-direction: row;
    opacity: 1;
    background: var(--surface);
    border-radius: 0 0 var(--r-sm) var(--r-sm);
    padding: 4px;
    border: 1px solid var(--border);
    border-top: none;
  }
}

.page-ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--bg-2);
  color: var(--text-muted);
  cursor: pointer;
}
.page-ctrl-btn:hover { color: var(--text); background: var(--surface-hover); }
.page-ctrl-btn.danger:hover { color: var(--danger); }
.page-ctrl-btn.restore {
  background: rgba(52,211,153,0.15);
  color: var(--success);
}

.page-wrap.deleted .page-canvas,
.page-wrap.deleted .overlay-canvas {
  opacity: 0.25;
  filter: grayscale(1);
}

/* ── Floating toolbar (Element 2 with backdrop-filter) ── */
#toolbar {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
  display: none;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  background: rgba(7, 11, 20, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: 100px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  overflow-x: auto;
  max-width: calc(100vw - 32px);
  scrollbar-width: none;
}
#toolbar::-webkit-scrollbar { display: none; }
#toolbar.visible { display: flex; }

.tool-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  width: 48px;
  height: 48px;
  border-radius: 100px;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  transition: color 0.15s;
  flex-shrink: 0;
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.03em;
}
.tool-btn:hover { color: var(--text); }
.tool-btn:active { transform: scale(0.92); }
.tool-btn[aria-pressed="true"] { color: var(--accent-cyan); }

#toolbar-indicator {
  position: absolute;
  height: 100%;
  border-radius: 100px;
  background: rgba(34, 211, 238, 0.12);
  border: 1px solid rgba(34, 211, 238, 0.25);
  transition: left 0.2s var(--ease), width 0.2s var(--ease);
  pointer-events: none;
  top: 0;
}

.toolbar-sep {
  width: 1px;
  height: 28px;
  background: var(--border);
  flex-shrink: 0;
}

.colour-swatch {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.3);
  cursor: pointer;
}

.size-input {
  width: 44px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  color: var(--text);
  font: 600 0.8rem var(--font);
  text-align: center;
  padding: 4px;
  height: 32px;
}
.size-input:focus { border-color: var(--accent-cyan); outline: none; }

#colour-picker {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}

.colour-picker-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
}

/* ── Sign modal ── */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 500;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.modal-overlay.open { display: flex; }

.modal {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: 28px;
  width: 100%;
  max-width: 420px;
}

.modal h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 16px;
}

#sign-canvas {
  display: block;
  width: 100%;
  height: 160px;
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  background: rgba(255,255,255,0.03);
  touch-action: none;
  cursor: crosshair;
}

.modal-actions {
  display: flex;
  gap: 10px;
  margin-top: 16px;
  justify-content: flex-end;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.875rem;
  line-height: 1.4;
  cursor: pointer;
  color: var(--text-muted);
}
.check-row input[type="checkbox"] {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  margin-top: 1px;
  accent-color: var(--accent-cyan);
  cursor: pointer;
}
.check-row strong { color: var(--text); }

/* ── Page number badge ── */
.page-num-badge {
  position: absolute;
  bottom: -24px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.7rem;
  color: var(--text-muted);
  white-space: nowrap;
}

/* ── Empty state ── */
.empty-state {
  text-align: center;
  padding: 48px 24px;
  color: var(--text-muted);
}
.empty-state svg { margin-bottom: 16px; color: var(--border-glow); }
.empty-state p { font-size: 0.95rem; line-height: 1.6; }

/* ── Deleted label ── */
.deleted-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(248,113,113,0.08);
  border: 1px dashed rgba(248,113,113,0.4);
  border-radius: var(--r-sm);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--danger);
  letter-spacing: 0.08em;
  pointer-events: none;
  opacity: 0;
}
.page-wrap.deleted .deleted-label { opacity: 1; }

/* ── Inline text editing ── */
.text-edit-layer {
  position: absolute;
  top: 0; left: 0;
  pointer-events: auto;
  z-index: 5;
  touch-action: auto;
  overflow: visible;
}

.text-seg {
  position: absolute;
  display: inline-block;
  white-space: pre;
  overflow: hidden;
  cursor: text;
  user-select: text;
  -webkit-user-select: text;
  box-sizing: border-box;
  color: transparent;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  caret-color: auto;
  min-height: 1em;
  z-index: 5;
  line-height: 1;
  border-radius: 2px;
}

.text-seg:hover {
  outline: 1.5px dashed rgba(34, 211, 238, 0.45);
  cursor: text;
  z-index: 6;
}

.scan-notice {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(7, 11, 20, 0.90);
  border: 1px solid rgba(251, 191, 36, 0.35);
  border-radius: 100px;
  padding: 8px 16px;
  font-size: 0.78rem;
  color: var(--warning);
  white-space: nowrap;
  pointer-events: none;
  z-index: 15;
}
.scan-notice svg { flex-shrink: 0; }
.scan-notice strong { color: var(--text); }

/* ── OCR Banner & Progress ── */
.ocr-banner {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(34, 211, 238, 0.35);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  border-radius: 12px;
  padding: 10px 16px;
  font-size: 0.85rem;
  color: var(--text);
  z-index: 25;
  pointer-events: auto;
  max-width: 90%;
  backdrop-filter: blur(8px);
}
.ocr-banner-content {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.ocr-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ocr-lang-select {
  background: var(--bg-card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 0.8rem;
  cursor: pointer;
}
.ocr-btn {
  padding: 6px 12px;
  font-size: 0.82rem;
  background: var(--accent-cyan);
  color: #070B14;
  font-weight: 600;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  transition: opacity 0.15s;
}
.ocr-btn:hover { opacity: 0.9; }
.ocr-btn:disabled { opacity: 0.5; cursor: wait; }
.ocr-progress-container {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
}
.ocr-progress-bar {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
  overflow: hidden;
}
.ocr-progress-fill {
  width: 0%;
  height: 100%;
  background: var(--accent-cyan);
  transition: width 0.2s ease;
}
.ocr-progress-status {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.text-seg.edited {
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.4);
}
.text-seg:focus {
  outline: 1.5px dashed var(--accent-cyan) !important;
  z-index: 20 !important;
}
.text-seg[dir="rtl"] {
  text-align: right;
  direction: rtl;
}

#tool-redo[disabled],
#tool-undo[disabled] { opacity: 0.3; cursor: default; }

/* ── Mobile and Low-End Performance Fallbacks ── */
@media (max-width: 768px), (prefers-reduced-motion: reduce) {
  header, #toolbar, .glass-panel, .tile, .toast, .modal-overlay {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
  header { background: rgba(7, 11, 20, 0.95); }
  #toolbar { background: rgba(7, 11, 20, 0.95); }
}

body.low-perf header,
body.low-perf #toolbar,
body.low-perf .glass-panel,
body.low-perf .tile,
body.low-perf .toast,
body.low-perf .modal-overlay {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}
body.low-perf header,
body.low-perf #toolbar {
  background: rgba(7, 11, 20, 0.95);
}

@media (max-width: 600px) {
  header { padding: 12px 16px; }
  .screen { padding: 20px 16px; }
  .hero { padding: 32px 0 24px; }
  .tiles { grid-template-columns: 1fr; }
  .tile-edit { grid-column: 1; }
  .glass-panel { padding: 16px; }
  #toolbar { gap: 2px; padding: 4px 8px; }
  .tool-btn { width: 42px; height: 42px; }
  .edit-canvas-area { padding-bottom: 100px; }
}
